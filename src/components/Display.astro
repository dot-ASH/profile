---
import { profile, images, randomKeys, quotes, track, playlist, splitSentence } from '../data/profile';
import HeroPortrait from './HeroPortrait.astro';
import MusicPlayer from './islands/MusicPlayer.svelte';

const [firstName, lastName] = [splitSentence(profile.Name, 0), splitSentence(profile.Name, 1)];
---

<section id="display">
  <div class="home flex justify-between py-[1rem] my-[1rem] sm:mx-[3rem] lg:mx-[4rem] 2xl:mx-[6rem]">
    <!-- left column: dated photo + the name -->
    <div class="flex w-[35%] sm:mt-[4rem] relative left-display">
      <div
        class="hidden sm:flex flex-row absolute justify-end dp-02 w-[215px] h-[250px] rounded-[0.3rem] showBorder xl:ml-[2rem] 2xl:ml-[3rem] overflow-hidden"
        data-reveal="left"
        data-reveal-duration="0.5"
        data-reveal-delay="0.5"
        data-reveal-ease="circ"
      >
        <img src={images.other[0].url} width="902" height="1128" alt="" class="cloud-image alt-image" loading="lazy" decoding="async" />
        <div class="flex year-text-bg justify-center items-center bottom-0 w-full h-[15%]">
          <p class="prime-font text-2xl">'{images.other[0].name}</p>
        </div>
      </div>

      <div class="name block relative mt-[18rem] xl:mt-[20rem] xl:ml-[3rem] z-[1000]">
        <b>
          <p class="hidden sm:block non-prime-font uppercase text-[3rem] 2xl:text-[3vw] text-[#ffe5d9] smoothed disable-select">
            {firstName}
          </p>
        </b>
        <b>
          <p class="hidden sm:block non-prime-font text-[3rem] 2xl:text-[4vw] text-[#ffe5d9] smoothed disable-select">
            {lastName}
          </p>
        </b>
      </div>

      <div class="sm:hidden absolute" data-reveal="left" data-reveal-delay="0.5" data-reveal-once="false">
        <p class="relative text-[#ffe5d9] text-3xl quote-font mt-[25rem] ml-[-1rem] z-[40] text-right uppercase">
          {randomKeys[2]} &nbsp;<br />
          {randomKeys[3]} &nbsp;<br />
          {randomKeys[4]}
        </p>
      </div>
    </div>

    <!-- centre: the portrait, at three sizes -->
    {/* All three share one arc (r=190, height=215) — see CurveText. Only the
        svg box and font size vary per breakpoint, as they did before. */}
    <HeroPortrait class="sm:hidden flex" bio={profile.Bio} image={images.primary} r={190} fontSize={17} curveHeight={215} />
    <HeroPortrait class="hidden sm:flex xl:hidden" bio={profile.Bio} image={images.primary} r={190} fontSize={20} curveHeight={210} />
    <HeroPortrait class="m-dp hidden xl:flex" bio={profile.Bio} image={images.primary} r={190} fontSize={20} curveHeight={220} />

    <MusicPlayer
      client:visible
      src={track.src}
      title={track.title}
      trackUrl={track.url}
      playlistUrl={playlist.url}
      cover="/img/songCover.webp"
      playlistCover="/img/spdp.webp"
    />

    <!-- right column -->
    <div class="flex relative items-center w-[35%] dp-container right-display" data-before={images.other[1].name}>
      <div class="sm:hidden absolute ml-[1rem]" data-reveal="right" data-reveal-delay="0.5" data-reveal-once="false">
        <p class="relative text-[#ffe5d9] text-3xl mono-font ml-[1rem] mt-[-15rem] z-[40] uppercase">
          {randomKeys[0]}<br />
          {randomKeys[1]}
        </p>
        <p class="text-3xl mono-font outline-text ml-[4rem] mt-[-1rem] z-[20] uppercase">
          {randomKeys[0]}<br />
          &nbsp; {randomKeys[1]}
        </p>
      </div>

      <div
        class="hidden sm:flex absolute dp-01 left-[45%] w-[270px] rounded-[3rem] showBorder overflow-hidden"
        data-reveal="right"
        data-reveal-delay="0.5"
        data-reveal-ease="circ"
      >
        <img src={images.other[1].url} width="2500" height="2852" class="hover:scale-110 duration-500 ease-out" alt="" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>

  <!-- the separate mobile composition -->
  <div class="absolute pt-[22rem] small-show sm:hidden gap-[2rem]">
    <div class="pl-[2rem] pb-[2rem] quote-font text-[#bfaca4]">
      {
        quotes.slice(0, 3).map((line, index) => (
          <p class="relative" data-reveal="left" data-reveal-once="false" data-reveal-delay={index * 0.05}>
            {line}
          </p>
        ))
      }
    </div>

    <div class="pr-[2rem] pt-[3rem] text-right quote-font text-[#bfaca4] z-[500]">
      {
        quotes.slice(3, 6).map((line, index) => (
          <p class="relative" data-reveal="right" data-reveal-once="false" data-reveal-delay={index * 0.05}>
            {line}
          </p>
        ))
      }
    </div>

    <div class="name absolute z-[1000] mt-[-3rem]" data-reveal="scale" data-reveal-duration="1.5" data-reveal-delay="0.5">
      <b>
        <p class="non-prime-font uppercase sm:text-[4vw] text-[#ffe5d9] smoothed disable-select">{firstName}</p>
      </b>
      <b>
        <p class="non-prime-font sm:text-[5vw] text-[#ffe5d9] smoothed disable-select">{lastName}</p>
      </b>
    </div>

    <img src="/img/cf1.webp" class="cf" width="794" height="1123" alt="" loading="lazy" decoding="async" />

    <div class="override-line">
      <div class="flex absolute bg-black w-[200px] dp-small top-[15%] overflow-hidden" data-reveal="right" data-reveal-duration="1.2" data-reveal-once="false">
        <img src={images.other[1].url} width="2500" height="2852" alt="" class="hover:scale-110 duration-500 ease-out z-[300]" loading="lazy" decoding="async" />
      </div>
    </div>

    <div
      class="flex absolute dp-02 w-[250px] h-[270px] rounded-[0.3rem] overflow-hidden opacity-70 bottom-[6%] left-[4em] z-[1000]"
      data-reveal="fade"
      data-reveal-duration="1.5"
      data-reveal-once="false"
    >
      <img src={images.other[0].url} width="902" height="1128" alt="" class="cloud-image absolute" loading="lazy" decoding="async" />
    </div>
  </div>
</section>

<style>
  #display {
    position: relative;
    z-index: 50;
  }

  .home {
    height: 72vh;
  }

  .dp-container::before {
    position: absolute;
    margin-left: 120px;
    margin-top: -270px;
    content: attr(data-before);
    width: 200px;
    height: 200px;
    color: var(--cream);
    font-family: 'carmine', serif;
    font-size: 72px;
    z-index: 300;
    font-weight: bold;
    pointer-events: none;
  }

  .override-line {
    margin-left: 7em;
    width: 400px;
    height: 230px;
  }

  .override-line::after {
    position: absolute;
    content: '';
    border: 1px solid rgb(124, 124, 124);
    top: 16%;
    right: 2%;
    width: 220px;
    height: 224px;
    margin-top: 20px;
    overflow: visible;
    z-index: 250;
    border-top-left-radius: 50px;
    border-bottom-left-radius: 50px;
    border-bottom-right-radius: 15px;
  }

  .dp-small {
    border-top-left-radius: 50px;
    border-bottom-left-radius: 50px;
    z-index: 500;
  }

  .year-text-bg {
    position: absolute;
    background-color: var(--surface);
    color: var(--on-surface);
    transition: background-color 500ms ease-out, color 500ms ease-out;
    box-shadow: 0 0 60px 10px rgb(109, 95, 95);
  }

  .dp-01 {
    box-shadow: 0 0 70px 3px #3d3d3d;
  }

  .dp-02 {
    background-color: #000000;
    border-top-left-radius: 160px;
    border-top-right-radius: 160px;
    box-shadow: 0 0 30px 3px #555454;
    transition: 500ms;
  }

  @media (max-width: 420px) {
    .small-show {
      margin-top: -2rem;
    }

    .name {
      left: 20%;
      margin-top: -4rem;
    }
  }

  @media (max-width: 640px) {
    .home {
      height: 42rem;
    }

    .dp-container::before {
      display: none;
    }

    .cf {
      position: absolute;
      top: 17%;
      left: 3%;
    }

    .small-show::before {
      content: '';
      position: absolute;
      width: auto;
      border-top: 1px solid var(--cream);
      bottom: 48%;
      left: 2em;
      right: 2em;
      z-index: 50;
    }

    .small-show {
      height: 57rem;
      color: #494f42;
      position: relative;
      background: var(--ink);
      box-shadow: 0 0 70px 100px var(--ink);
      margin-bottom: -60px;
      pointer-events: none;
      user-select: none;
    }

    .name {
      top: 2%;
      left: 25%;
      font-size: 11vw;
      text-align: center;
    }

    .name p {
      letter-spacing: 0.4rem;
    }

    .dp-02 {
      box-shadow: 0 0 40px 5px #5f5656;
    }
  }

  @media (min-width: 640px) {
    .left-display {
      transform: scale(1.1);
      margin-top: 5rem;
    }

    .right-display {
      transform: scale(1.1);
      margin-top: 3rem;
    }

    .dp-container::before {
      margin-left: 182px;
      margin-top: -200px;
    }
  }

  @media (min-width: 640px) and (max-height: 700px) {
    .home {
      height: 32rem;
    }
  }

  @media (max-width: 640px) and (max-height: 700px) {
    .home {
      margin-top: -2em;
    }
  }

  @media (min-width: 640px) and (min-height: 700px) {
    .home {
      height: 73vh;
    }
  }

  @media (min-width: 640px) and (min-height: 850px) {
    .home {
      height: 77vh;
    }
  }

  @media (min-width: 1280px) {
    .dp-02 {
      width: 250px;
      height: 300px;
    }
  }

  @media (min-width: 1536px) {
    .left-display {
      margin-top: 6rem;
    }

    .dp-container::before {
      margin-left: 256px;
      margin-top: -192px;
    }
  }
</style>
